# ---------------------------------------------------------------------------
# Etoh Cols (บริษัท อิโตะ คอลส์ จำกัด) — deployment values
# Copy to .env.local (or Portainer stack env). Contact values come from the
# company's own poster; legal values marked TODO must be filled before go-live.
# `npm run build` refuses NEXT_PUBLIC_ALLOW_INDEXING=true while TODOs remain.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://www.etohcols.co.th
NEXT_PUBLIC_SITE_NAME=Etoh Cols
NEXT_PUBLIC_SITE_PHONE_DISPLAY=02-100-6987
NEXT_PUBLIC_SITE_PHONE_HREF=tel:+6621006987
NEXT_PUBLIC_SITE_EMAIL=sales@etohcols.co.th
NEXT_PUBLIC_LINE_ID=@etohcols
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@etohcols
NEXT_PUBLIC_ALLOW_INDEXING=false

SITE_LEGAL_NAME=บริษัท อิโตะ คอลส์ จำกัด
# TODO: 13-digit DBD tax ID (printed on quotations / tax invoices)
SITE_TAX_ID=
# TODO: registered address exactly as on ภ.พ.20
SITE_STREET_ADDRESS=
SITE_ADDRESS_LOCALITY=
SITE_ADDRESS_REGION=กรุงเทพมหานคร
SITE_POSTAL_CODE=
SITE_BUSINESS_TYPE=WholesaleStore
SITE_OPENING_HOURS=Mo-Sa 08:30-17:30

# Payments (PromptPay = tax ID for a juristic person)
PROMPTPAY_ID=
BANK_ACCOUNT_NAME=บริษัท อิโตะ คอลส์ จำกัด

# Separate database from Smart Gift — never share SQLITE_PATH between businesses
SQLITE_PATH=.data/etoh.sqlite

# Ops console
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# NEXTERP group consolidation (outbox push, HMAC-SHA256 signed)
NEXTERP_SYNC_URL=
NEXTERP_SYNC_SECRET=
# Cron: POST /api/jobs/etoh-nexterp-sync with Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# LINE alerts to sales (Messaging API). Recipients: comma-separated userId (U…) / groupId (C…)
LINE_CHANNEL_ACCESS_TOKEN=
ETOH_SALES_LINE_TO=
ETOH_OPS_BASE_URL=https://www.etohcols.co.th
# Cron: POST /api/jobs/etoh-daily-digest with Authorization: Bearer $CRON_SECRET (daily 08:15 Bangkok)
