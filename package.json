{
  "name": "premium-giftset-web",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/load-env.mjs next dev",
    "build": "npm run validate:env && next build",
    "start": "node scripts/load-env.mjs next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "node scripts/migrate.mjs",
    "cms:bootstrap": "node scripts/bootstrap-strapi.mjs",
    "backup:leads": "node scripts/backup-leads.mjs",
    "restore:leads": "node scripts/restore-leads.mjs",
    "lhci": "lhci autorun",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "check:demo": "node scripts/check-demo-placeholders.mjs",
    "sprint2:preflight": "node scripts/sprint2-preflight.mjs",
    "sprint2:apply-intake": "node scripts/apply-sprint2-intake.mjs",
    "sprint2:staging-demo": "node scripts/sprint2-staging-demo.mjs",
    "staging:up": "node scripts/staging-up.mjs",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "uat:auto": "node scripts/uat-auto.mjs",
    "build:standalone": "npm run build && node scripts/prepare-standalone.mjs",
    "cms:setup": "node scripts/cms-local-setup.mjs",
    "cms:seed": "node scripts/seed-strapi-content.mjs",
    "images:stock": "node scripts/fetch-stock-images.mjs",
    "1688:sync": "node scripts/sync-1688-strapi.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
