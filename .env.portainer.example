# Copy values into the Portainer stack env (do not commit a filled .env.portainer).
# Public hostname: https://tarabiz.next-dev.net

NEXT_PUBLIC_SITE_URL=https://tarabiz.next-dev.net
NEXT_PUBLIC_SITE_NAME=เทราบิส
NEXT_PUBLIC_SITE_DESCRIPTION=รับผลิตของขวัญองค์กรและสินค้าพรีเมียม สกรีนโลโก้ได้
NEXT_PUBLIC_ALLOW_INDEXING=false
CMS_MODE=mock
STRAPI_FALLBACK_TO_MOCK=true
STRAPI_ADMIN_URL=http://192.168.1.30:33137/admin
STRAPI_API_TOKEN=
NEXT_IMAGE_REMOTE_URLS=http://192.168.1.30:33920,https://tarabiz.next-dev.net

WEB_HOST_PORT=33100
CMS_HOST_PORT=33137
MINIO_HOST_API_PORT=33920
MINIO_HOST_CONSOLE_PORT=33921
MINIO_REPLICA_API_PORT=33922
MINIO_REPLICA_CONSOLE_PORT=33923

POSTGRES_DB=giftset
POSTGRES_USER=giftset
POSTGRES_PASSWORD=change-me-postgres

MINIO_ROOT_USER=terabis
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_ACCESS_KEY=giftset-app
MINIO_SECRET_KEY=change-me-minio-app
MINIO_BUCKET_PRIVATE=terabis-private
MINIO_BUCKET_PUBLIC=terabis-public
MINIO_BUCKET_CONFIDENTIAL=terabis-confidential
MINIO_BUCKET_RESTRICTED=terabis-restricted
MINIO_PUBLIC_BASE_URL=http://192.168.1.30:33920/terabis-public
MINIO_RETENTION_DAYS=1825

CMS_APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
CMS_API_TOKEN_SALT=tobemodified
CMS_ADMIN_JWT_SECRET=tobemodified
CMS_TRANSFER_TOKEN_SALT=tobemodified
CMS_ENCRYPTION_KEY=tobemodified
CMS_JWT_SECRET=tobemodified

# /ops console — password min 12 chars; session secret min 32 chars
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
IP_HASH_SECRET=replace-with-at-least-32-random-characters
REVALIDATE_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Tunnel — enable compose profile `tunnel` in Portainer after pasting token
TUNNEL_TOKEN=
