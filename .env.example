NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=เทราบิส
NEXT_PUBLIC_SITE_DESCRIPTION=รับผลิตของขวัญองค์กรและสินค้าพรีเมียม สกรีนโลโก้ได้ — สั่งตามออเดอร์แล้วผลิตจากจีน ไม่ใช่ร้านค้าพร้อมส่ง
# Phone / email / LINE — leave empty until real contacts are approved (UI hides demo values)
NEXT_PUBLIC_SITE_PHONE_DISPLAY=
NEXT_PUBLIC_SITE_PHONE_HREF=
NEXT_PUBLIC_SITE_EMAIL=
NEXT_PUBLIC_LINE_ID=
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false
# P2 stubs only — Quote Basket + Product Configurator (see docs/P2-QUOTE-TOOLS.md)
NEXT_PUBLIC_ENABLE_P2_QUOTE_TOOLS=false
LEGAL_CONTENT_APPROVED=false
REAL_ASSETS_APPROVED=false
RUNTIME_SECRETS_APPROVED=false

SITE_LEGAL_NAME=บริษัท เทราบิส จำกัด
SITE_TAX_ID=0105556003873
SITE_ENABLE_LOCAL_BUSINESS_SCHEMA=true
SITE_BUSINESS_TYPE=ProfessionalService
SITE_STREET_ADDRESS=50/238 ซอยประชาอุทิศ 72
SITE_ADDRESS_LOCALITY=แขวงทุ่งครุ
SITE_ADDRESS_REGION=เขตทุ่งครุ กรุงเทพมหานคร
SITE_POSTAL_CODE=10140
SITE_COUNTRY_CODE=TH
SITE_LATITUDE=
SITE_LONGITUDE=
SITE_OPENING_HOURS=Mo-Sa 08:30-17:30

# Catalog source: mock | strapi | mysql (alias: nexterp)
CMS_MODE=mock
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_PUBLIC_READ=false
# When true, Strapi/MySQL fetch errors fall back to mock data (useful for partial local CMS setup)
STRAPI_FALLBACK_TO_MOCK=false
STRAPI_FETCH_TIMEOUT_MS=8000
NEXT_IMAGE_REMOTE_URLS=

# NextERP MySQL staging (products) — used when CMS_MODE=mysql|nexterp
# Default matches docker-compose in ข้อมูลสินค้า ทาราบิท/09_nexterp_mysql_staging
NEXTERP_MYSQL_ENABLED=false
NEXTERP_MYSQL_HOST=127.0.0.1
NEXTERP_MYSQL_PORT=3307
NEXTERP_MYSQL_USER=terabis
NEXTERP_MYSQL_PASSWORD=terabis
NEXTERP_MYSQL_DATABASE=nexterp_staging
# Optional full URL instead of discrete fields:
# NEXTERP_MYSQL_URL=mysql://terabis:terabis@127.0.0.1:3307/nexterp_staging

# 1688 factory cost → THB estimates (server-only). See data/1688-offers.example.json
ALIBABA_ESTIMATES_ENABLED=false
ALIBABA_OFFERS_PATH=data/1688-offers.json
ALIBABA_FX_CNY_THB=5
ALIBABA_PUBLIC_IMAGES=false
ALIBABA_IMAGES_LICENSED=false
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
# ALIBABA_GATEWAY_URL=https://gw.open.1688.com/openapi

REVALIDATE_SECRET=

LEAD_STORAGE_MODE=sqlite
SQLITE_PATH=.data/leads.sqlite
ALLOW_FILE_LEAD_STORAGE=false
LEAD_DATA_DIR=.data
IP_HASH_SECRET=replace-with-at-least-32-random-characters
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MINUTES=15

QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=
QUOTE_WEBHOOK_TIMEOUT_MS=8000
QUOTE_WEBHOOK_MAX_ATTEMPTS=6
QUOTE_WEBHOOK_RETRY_BASE_SECONDS=60
QUOTE_RETRY_BATCH_SIZE=25
CRON_SECRET=

# Local ops console (/ops) — customer + quote management (not Strapi)
# Password min 12 chars; session secret min 32 random chars
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# OpenRouter — Gemini photorealistic mockups (server-only, never commit real keys)
OPENROUTER_API_KEY=
OPENROUTER_MOCKUP_MODEL=google/gemini-2.5-flash-image
OPENROUTER_MOCKUP_ENABLED=true
# Optional ASCII-only app title for OpenRouter X-Title (Thai NEXT_PUBLIC_SITE_NAME is auto-fallback to Terabis)
OPENROUTER_APP_TITLE=Terabis
